{
  "name": "build-tool",
  "version": "1.0.0",
  "description": "Git repository build tool with web interface",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "pm2:kill": "./node_modules/.bin/pm2 kill",
    "pm2:start": "./node_modules/.bin/pm2 kill && ./node_modules/.bin/pm2 start ecosystem.config.js",
    "pm2:stop": "./node_modules/.bin/pm2 stop build-tool",
    "pm2:restart": "./node_modules/.bin/pm2 restart build-tool",
    "pm2:delete": "./node_modules/.bin/pm2 delete build-tool",
    "pm2:logs": "./node_modules/.bin/pm2 logs build-tool",
    "pm2:status": "./node_modules/.bin/pm2 status"
  },
  "dependencies": {
    "archiver": "^7.0.0",
    "express": "^4.21.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "pm2": "^7.0.3",
    "uuid": "^10.0.0"
  }
}
